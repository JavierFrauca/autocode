# SQLite (local). Por defecto autocode.db en el cwd; Electron lo apunta a %APPDATA%/AutoCode.
AUTOCODE_DB_PATH=

# Qdrant local (binario lanzado por Electron o, en dev, levantado a mano)
QDRANT_URL=http://localhost:6333

# API
API_PORT=4317
API_HOST=127.0.0.1

# Projects root (lo decide el usuario por UI; sobreescribe aquí solo para dev)
AUTOCODE_PROJECTS_ROOT=

# LiteLLM (el usuario los pone por UI; estos son fallbacks de dev)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL_CHAT=
LITELLM_MODEL_CODE=
LITELLM_MODEL_EMBEDDINGS=
LITELLM_MODEL_EMBEDDINGS_DIM=
LITELLM_MODEL_CHEAP=
