{
  "name": "autocode",
  "version": "0.1.4",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "node scripts/bump-version.mjs && npm run build && electron-builder",
    "test": "vitest run src/main/__tests__",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/session": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "diff": "^7.0.0",
    "drizzle-orm": "^0.36.4",
    "electron-updater": "^6.8.9",
    "fastify": "^5.1.0",
    "gray-matter": "^4.0.3",
    "koffi": "^3.0.2",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "mermaid": "^11.4.0",
    "open-websearch": "2.1.11",
    "openai": "^4.73.1",
    "pdf-parse": "^2.4.5",
    "pinia": "^2.2.6",
    "shiki": "^1.24.0",
    "tar": "^7.4.3",
    "turndown": "^7.2.4",
    "ulid": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^4.0.4",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/tar": "^6.1.13",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "drizzle-kit": "^0.28.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.autocode.desktop",
    "productName": "AutoCode",
    "files": [
      "out/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/open-websearch/**/*"
    ],
    "extraResources": [
      {
        "from": "prompts",
        "to": "prompts"
      },
      {
        "from": "library",
        "to": "library"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "vendor/nucleus",
        "to": "vendor/nucleus"
      },
      {
        "from": "mcp-internal",
        "to": "mcp-internal"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JavierFrauca",
        "repo": "autocode",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
