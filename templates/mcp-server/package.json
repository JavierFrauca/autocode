{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Servidor MCP (Model Context Protocol)",
  "type": "module",
  "main": "dist/stdio.js",
  "bin": { "mcp-server": "dist/stdio.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
