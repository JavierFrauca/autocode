{
  "name": "app-servidor",
  "version": "1.0.0",
  "description": "Aplicación cliente/servidor (Fastify + Vue + SQLite)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "vite build && tsc -p tsconfig.json && node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.1.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
